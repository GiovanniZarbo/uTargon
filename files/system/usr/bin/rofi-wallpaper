#!/usr/bin/env bash

# rofi-wallpaper - Selettore sfondi con anteprima grafica per Rofi & KDE Plasma
# Applica lo sfondo tramite plasma-apply-wallpaperimage e innesca l'aggiornamento
# dei colori dinamici tramite kde-material-you-colors.

set -o pipefail

WALLPAPER_DIRS=(
    "$HOME/Pictures/Wallpapers"
    "$HOME/Pictures/wallpapers"
    "$HOME/Pictures"
    "$HOME/.local/share/wallpapers"
    "/usr/share/wallpapers"
    "/usr/share/backgrounds"
)

declare -a WALLPAPER_NAMES=()
declare -a WALLPAPER_ICONS=()
declare -a WALLPAPER_PATHS=()
declare -A SEEN_PATHS=()

# Funzione per aggiungere un wallpaper alla lista evitando duplicati
add_wallpaper() {
    local name="$1"
    local icon="$2"
    local target="$3"

    if [[ -z "$target" || ! -f "$target" ]]; then
        return
    fi

    # Normalizza il percorso per evitare duplicati
    local real_target
    real_target="$(readlink -f "$target" 2>/dev/null || echo "$target")"

    if [[ -n "${SEEN_PATHS[$real_target]}" ]]; then
        return
    fi
    SEEN_PATHS["$real_target"]=1

    WALLPAPER_NAMES+=("$name")
    WALLPAPER_ICONS+=("$icon")
    WALLPAPER_PATHS+=("$real_target")
}

# 1. Scansione delle cartelle
for dir in "${WALLPAPER_DIRS[@]}"; do
    if [[ ! -d "$dir" ]]; then
        continue
    fi

    # Se siamo in /usr/share/wallpapers (o cartelle con pacchetti KDE wallpaper)
    for entry in "$dir"/*; do
        if [[ -d "$entry" ]]; then
            # Controlla se è un pacchetto KDE con contents/images
            local_img=""
            if [[ -d "$entry/contents/images" ]]; then
                # Cerca la migliore risoluzione disponibile
                local_img="$(find "$entry/contents/images" -maxdepth 1 -type f \( -iname "*.jpg" -o -iname "*.png" -o -iname "*.webp" \) 2>/dev/null | sort -Vr | head -n 1)"
            fi
            # O se ha screenshot.png come anteprima
            if [[ -z "$local_img" && -f "$entry/contents/screenshot.png" ]]; then
                local_img="$entry/contents/screenshot.png"
            fi

            if [[ -n "$local_img" && -f "$local_img" ]]; then
                pkg_name="$(basename "$entry")"
                add_wallpaper "$pkg_name" "$local_img" "$local_img"
            fi
        elif [[ -f "$entry" ]]; then
            case "${entry,,}" in
                *.jpg|*.jpeg|*.png|*.webp)
                    file_name="$(basename "$entry")"
                    clean_name="${file_name%.*}"
                    add_wallpaper "$clean_name" "$entry" "$entry"
                    ;;
            esac
        fi
    done
done

if [[ ${#WALLPAPER_PATHS[@]} -eq 0 ]]; then
    notify-send "Sfondi" "Nessuno sfondo trovato nelle cartelle supportate." -i preferences-desktop-wallpaper
    exit 0
fi

# 2. Configura il tema Rofi per la griglia
THEME_FLAG=()
if [[ -f "/etc/xdg/rofi/wallpaper.rasi" ]]; then
    THEME_FLAG=(-theme "/etc/xdg/rofi/wallpaper.rasi")
fi

# 3. Presenta la lista formattata con icone a Rofi
SELECTION_INDEX=$(
    for i in "${!WALLPAPER_NAMES[@]}"; do
        printf "%s\0icon\x1f%s\n" "${WALLPAPER_NAMES[$i]}" "${WALLPAPER_ICONS[$i]}"
    done | rofi -dmenu -i -format i -p "󰸉 Sfondi" "${THEME_FLAG[@]}"
)

# Se l'utente ha premuto ESC o annullato, esci silenziosamente
if [[ -z "$SELECTION_INDEX" || "$SELECTION_INDEX" -lt 0 ]]; then
    exit 0
fi

CHOSEN_NAME="${WALLPAPER_NAMES[$SELECTION_INDEX]}"
CHOSEN_PATH="${WALLPAPER_PATHS[$SELECTION_INDEX]}"
CHOSEN_ICON="${WALLPAPER_ICONS[$SELECTION_INDEX]}"

# 4. Applica lo sfondo in KDE Plasma con transizione animata (Circle Grow)
qdbus org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "
    var allDesktops = desktops();
    for (var i = 0; i < allDesktops.length; i++) {
        d = allDesktops[i];
        d.wallpaperPlugin = 'org.utargon.circlewallpaper';
        d.currentConfigGroup = Array('Wallpaper', 'org.utargon.circlewallpaper', 'General');
        d.writeConfig('Image', 'file://${CHOSEN_PATH}');
    }
" 2>/dev/null || true

# Sincronizza anche con il comando standard per aggiornare le impostazioni di sistema
if command -v plasma-apply-wallpaperimage &>/dev/null; then
    (plasma-apply-wallpaperimage "$CHOSEN_PATH" &>/dev/null &) 2>/dev/null || true
fi

# 5. Notifica visiva di conferma
notify-send "Sfondo Applicato" "$CHOSEN_NAME" -i "$CHOSEN_ICON" -t 3000

# 6. Generazione colori dinamici Material You stile Dusky (Matugen)
# Aggiorna Kitty terminale (con reload live SIGUSR1) e stili GTK
if command -v matugen &>/dev/null; then
    (matugen image "$CHOSEN_PATH" &>/dev/null &) 2>/dev/null || true
fi

# 7. Aggiornamento colori KDE Plasma (finestre, decorazioni e Plasma Panel Colorizer)
if command -v kde-material-you-colors &>/dev/null; then
    (kde-material-you-colors --color "$CHOSEN_PATH" &>/dev/null &) 2>/dev/null || true
fi

exit 0

