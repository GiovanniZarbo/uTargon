#!/usr/bin/env bash

# rofi-wallpaper - Selettore sfondi grafico con Rofi per uTargon (KDE Plasma 6)
# - Applica lo sfondo con l'animazione nativa di KDE Plasma
# - Cambia l'icona di Kickoff in base al wallpaper (Lain o Madoka)
# - Rigenera la palette dinamica con matugen, unico motore colore: kitty, GTK
#   e variante del tema icone Fluent; per i colori di Plasma pensa il demone
#   kde-material-you-colors in autostart, che rileva da solo il cambio sfondo

set -o pipefail

WALLPAPER_DIRS=(
    "$HOME/Pictures/Wallpapers"
    "$HOME/Pictures/wallpapers"
    "$HOME/Pictures"
    "$HOME/.local/share/wallpapers"
    "/usr/share/wallpapers"
    "/usr/share/backgrounds"
)

declare -a WALLPAPER_NAMES=()
declare -a WALLPAPER_ICONS=()
declare -a WALLPAPER_PATHS=()
declare -A SEEN_PATHS=()

add_wallpaper() {
    local name="$1"
    local icon="$2"
    local target="$3"

    if [[ -z "$target" || ! -f "$target" ]]; then
        return
    fi

    local real_target
    real_target="$(readlink -f "$target" 2>/dev/null || echo "$target")"

    if [[ -n "${SEEN_PATHS[$real_target]}" ]]; then
        return
    fi
    SEEN_PATHS["$real_target"]=1

    WALLPAPER_NAMES+=("$name")
    WALLPAPER_ICONS+=("$icon")
    WALLPAPER_PATHS+=("$real_target")
}

# 1. Scansione delle cartelle sfondi
for dir in "${WALLPAPER_DIRS[@]}"; do
    if [[ ! -d "$dir" ]]; then
        continue
    fi

    for entry in "$dir"/*; do
        if [[ -d "$entry" ]]; then
            local_img=""
            if [[ -d "$entry/contents/images" ]]; then
                local_img="$(find "$entry/contents/images" -maxdepth 1 -type f \( -iname "*.jpg" -o -iname "*.png" -o -iname "*.webp" \) 2>/dev/null | sort -Vr | head -n 1)"
            fi
            if [[ -z "$local_img" && -f "$entry/contents/screenshot.png" ]]; then
                local_img="$entry/contents/screenshot.png"
            fi

            if [[ -n "$local_img" && -f "$local_img" ]]; then
                pkg_name="$(basename "$entry")"
                add_wallpaper "$pkg_name" "$local_img" "$local_img"
            fi
        elif [[ -f "$entry" ]]; then
            case "${entry,,}" in
                *.jpg|*.jpeg|*.png|*.webp)
                    file_name="$(basename "$entry")"
                    clean_name="${file_name%.*}"
                    add_wallpaper "$clean_name" "$entry" "$entry"
                    ;;
            esac
        fi
    done
done

if [[ ${#WALLPAPER_PATHS[@]} -eq 0 ]]; then
    notify-send "Sfondi" "Nessuno sfondo trovato nelle cartelle supportate." -i preferences-desktop-wallpaper
    exit 0
fi

# 2. Configura il tema Rofi
THEME_FLAG=()
if [[ -f "/etc/xdg/rofi/wallpaper.rasi" ]]; then
    THEME_FLAG=(-theme "/etc/xdg/rofi/wallpaper.rasi")
elif [[ -f "$HOME/.config/rofi/wallpaper.rasi" ]]; then
    THEME_FLAG=(-theme "$HOME/.config/rofi/wallpaper.rasi")
fi

# 3. Presenta la griglia a Rofi
SELECTION_INDEX=$(
    for i in "${!WALLPAPER_NAMES[@]}"; do
        printf "%s\0icon\x1f%s\n" "${WALLPAPER_NAMES[$i]}" "${WALLPAPER_ICONS[$i]}"
    done | rofi -dmenu -i -format i -p "󰸉 Sfondi" "${THEME_FLAG[@]}"
)

# Se annullato con ESC
if [[ -z "$SELECTION_INDEX" || "$SELECTION_INDEX" -lt 0 ]]; then
    exit 0
fi

CHOSEN_NAME="${WALLPAPER_NAMES[$SELECTION_INDEX]}"
CHOSEN_PATH="${WALLPAPER_PATHS[$SELECTION_INDEX]}"
CHOSEN_ICON="${WALLPAPER_ICONS[$SELECTION_INDEX]}"

# 4. Applica lo sfondo in KDE Plasma con il metodo e l'animazione nativa di KDE
if command -v plasma-apply-wallpaperimage &>/dev/null; then
    plasma-apply-wallpaperimage "$CHOSEN_PATH"
else
    qdbus org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "
        var allDesktops = desktops();
        for (var i = 0; i < allDesktops.length; i++) {
            d = allDesktops[i];
            d.wallpaperPlugin = 'org.kde.image';
            d.currentConfigGroup = Array('Wallpaper', 'org.kde.image', 'General');
            d.writeConfig('Image', 'file://${CHOSEN_PATH}');
        }
    " 2>/dev/null || true
fi

# Rileva l'eseguibile corretto di qdbus (Plasma 6 usa qdbus6)
QDBUS_BIN=""
if command -v qdbus6 &>/dev/null; then
    QDBUS_BIN="qdbus6"
elif command -v qdbus &>/dev/null; then
    QDBUS_BIN="qdbus"
elif command -v qdbus-qt6 &>/dev/null; then
    QDBUS_BIN="qdbus-qt6"
fi

# 5. Cambia icona di Kickoff (Start Menu) in base al wallpaper (Lain o Madoka)
TARGET_CHECK="${CHOSEN_NAME,,} ${CHOSEN_PATH,,}"
KICKOFF_ICON="/usr/share/pixmaps/start-menu-lain.png"
if [[ "$TARGET_CHECK" == *"madoka"* ]]; then
    KICKOFF_ICON="/usr/share/pixmaps/start-menu-madoka.png"
elif [[ "$TARGET_CHECK" == *"lain"* ]]; then
    KICKOFF_ICON="/usr/share/pixmaps/start-menu-lain.png"
fi

if [[ -n "$QDBUS_BIN" ]]; then
    "$QDBUS_BIN" org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "
        var allPanels = panels();
        for (var i = 0; i < allPanels.length; i++) {
            var p = allPanels[i];
            var widgets = p.widgets();
            for (var j = 0; j < widgets.length; j++) {
                if (widgets[j].type === 'org.kde.plasma.kickoff') {
                    widgets[j].currentConfigGroup = ['General'];
                    widgets[j].writeConfig('icon', '${KICKOFF_ICON}');
                    widgets[j].reloadConfig();
                }
            }
        }
    " 2>/dev/null || true
fi

# 6. Rigenera la palette dinamica con matugen (kitty, GTK, variante Fluent)
if command -v matugen &>/dev/null; then
    # Skel non viene copiato nella home di utenti esistenti al rebase: senza
    # config matugen parte con quella vuota di default (zero template) e le
    # icone non cambiano. Idempotente: per i nuovi utenti è già tutto presente.
    if [[ ! -f "$HOME/.config/matugen/config.toml" ]]; then
        mkdir -p "$HOME/.config/matugen/templates"
        cp /etc/skel/.config/matugen/config.toml "$HOME/.config/matugen/" 2>/dev/null || true
        cp /etc/skel/.config/matugen/templates/* "$HOME/.config/matugen/templates/" 2>/dev/null || true
    fi
    (matugen image "$CHOSEN_PATH" &>/dev/null &) 2>/dev/null || true
fi

# 7. Notifica visiva di conferma
notify-send "Sfondo Aggiornato" "$CHOSEN_NAME" -i "$CHOSEN_ICON" -t 3000

exit 0
